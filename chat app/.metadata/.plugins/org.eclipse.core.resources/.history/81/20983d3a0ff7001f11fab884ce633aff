    // Get all users and map to DTOs
    public List<UserResponseDTO> getAllUsers() {
        return userRepository.findAll().stream()
                .map(user -> new UserResponseDTO(
                        user.getId(),
                        user.getUsername(),
                        user.getPhone(),
                        user.getProfilePicture(), null))
                .collect(Collectors.toList());
    }

    
 // Save user from DTO with phone number existence check
    public UserResponseDTO saveUser(CreateUserRequestDTO requestDTO) {
        // Check if phone number already exists
        if (userRepository.existsByPhone(requestDTO.getPhone())) {
            // You can throw an exception here if you want to handle it centrally
            throw new PhoneNumberAlreadyExistsException("Phone number already exists");
            
        }
        User user = new User();
     // Save the uploaded photo
        if (requestDTO.getProfilePicture() != null) {
            String filePath;
			try {
				filePath = fileStorageService.saveFile(requestDTO.getProfilePicture());
				 user.setProfilePicture(filePath); // Save file path in the database
			} catch (IOException e) {
				System.err.println("IMAGE TOO LARGE"+e.getMessage());
				throw new PhoneNumberAlreadyExistsException(e.getMessage());
			}
           
        }
        
      
        user.setUsername(requestDTO.getUsername());
        user.setPhone(requestDTO.getPhone());
     // Encrypt the password before saving
        user.setPassword(passwordEncoder.encode( requestDTO.getPassword()));
        User savedUser = userRepository.save(user);
        System.out.println("ENTIty of user : "+savedUser.getProfilePicture()+" , "+savedUser.getUsername());
        return new UserResponseDTO(
                savedUser.getId(),
                savedUser.getUsername(),
                savedUser.getPhone(),
                savedUser.getProfilePicture(),
                savedUser.getPassword()
        );
    }
    
    //update user
    public UserResponseDTO updateUser(Long id, CreateUserRequestDTO requestDTO) {
        User existingUser = userRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("User not found with id: " + id));

        existingUser.setUsername(requestDTO.getUsername());
        
        User updatedUser = userRepository.save(existingUser);

        return new UserResponseDTO(
                updatedUser.getId(),
                updatedUser.getUsername(),
                updatedUser.getPhone(),
                updatedUser.getProfilePicture(),
                updatedUser.getPassword()
        );
    }

